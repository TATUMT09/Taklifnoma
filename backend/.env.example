PORT=3001

# JWT imzolash uchun sir kalit (ixtiyoriy, ishlab chiqarishda albatta o'zgartiring)
JWT_SECRET=

# Admin akkaunt (ikkalasi ham to'ldirilsa, shu email/parol bilan admin yaratiladi)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
